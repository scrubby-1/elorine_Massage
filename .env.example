# Supabase (alleen op de server gebruikt)
SUPABASE_URL=
# Service-role-sleutel uit Supabase > Project Settings > API. Nooit delen of in de browser gebruiken.
SUPABASE_SERVICE_ROLE_KEY=

# Beheerder (/admin) — let op: GEEN NEXT_PUBLIC_ ervoor, anders komt het wachtwoord in de browser terecht
ADMIN_PASSWORD=
# Willekeurige lange tekst om de login-cookie te ondertekenen
ADMIN_SESSION_SECRET=

# Gmail (versturen van bevestigingsmails)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Google Agenda
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Optioneel: agenda-ID (standaard wordt GMAIL_USER gebruikt)
GOOGLE_CALENDAR_ID=
